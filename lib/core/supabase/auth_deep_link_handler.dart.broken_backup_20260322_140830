import 'dart:async';

import 'package:app_links/app_links.dart';
import 'package:flutter/foundation.dart';
import 'package:flutter/material.dart';

import 'supabase_bootstrap.dart';

class AuthDeepLinkHandler {
  AuthDeepLinkHandler._();

  static final navigatorKey = GlobalKey<NavigatorState>();
  static final _appLinks = AppLinks();

  static StreamSubscription<Uri>? _sub;
  static bool _started = false;
  static bool _busy = false;

  static Future<void> start() async {
    if (_started) return;
    _started = true;

    try {
      final initial = await _appLinks.getInitialLink();
      if (initial != null) {
        await _handle(initial);
      }
    } catch (e) {
    }

    _sub = _appLinks.uriLinkStream.listen((uri) async {
      await _handle(uri);
    });
  }

  static Future<void> _handle(Uri uri) async {
    if (_busy) return;
    _busy = true;

    try {
      debugPrint('DL uri: $uri');
      debugPrint('DL query: ${uri.queryParameters}');
      debugPrint('DL fragment: ${uri.fragment}');

      if (uri.scheme != 'athletelab') return;

      final params = <String, String>{};

      params.addAll(uri.queryParameters);

      if (uri.fragment.isNotEmpty) {
        final fragmentParams = Uri.splitQueryString(uri.fragment);
        params.addAll(fragmentParams);
      if (params.containsKey('code')) {
        debugPrint('DL password recovery flow detected');

        final nav = navigatorKey.currentState;
        if (nav != null) {
          nav.pushNamedAndRemoveUntil('/set-password', (_) => false);
        }

        return;
      }

      }

      final refreshToken = params['refresh_token'];
      final accessToken = params['access_token'];
      final rawType = params['type'];
      final type = rawType?.toLowerCase().trim();
      
      }


      debugPrint('DL parsed params: $params');
      debugPrint('DL parsed type: $type');
      debugPrint('DL has access token: ${accessToken != null && accessToken.isNotEmpty}');
      debugPrint('DL has refresh token: ${refreshToken != null && refreshToken.isNotEmpty}');

      if (refreshToken == null || refreshToken.isEmpty) {
        return;
      }

      await sb.auth.setSession(refreshToken);
      debugPrint('DL setSession ok');

      final nav = navigatorKey.currentState;
      if (nav == null) return;

      final isPasswordSetupFlow = type == 'invite' || type == 'recovery';

      if (isPasswordSetupFlow) {
        nav.pushNamedAndRemoveUntil('/set-password', (_) => false);
      } else {
        nav.pushNamedAndRemoveUntil('/', (_) => false);
      }
    } catch (e) {
      debugPrint('DL error: $e');
      final nav = navigatorKey.currentState;
      nav?.pushNamedAndRemoveUntil('/login', (_) => false);
    } finally {
      _busy = false;
    }
  }

  static Future<void> dispose() async {
    await _sub?.cancel();
    _sub = null;
    _started = false;
  }
}
